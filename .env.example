# Convex — required by convex-svelte and @mmailaender/convex-better-auth-svelte (build fails if missing)
# https://dashboard.convex.dev → your project → Settings
PUBLIC_CONVEX_URL=https://efficient-swan-827.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://efficient-swan-827.convex.site

# Optional server-side override for the auth proxy (see api/auth/[...all]/+server.ts)
# CONVEX_SITE_URL=

# Resend (required for /send route — use a real API key locally and in prod)
# RESEND_API_KEY=re_...

# Backblaze B2 (files-sdk) — used by SvelteKit POST /upload for presigned PUT URLs.
# Put real values in `.env.local` (gitignored). For production, set the same vars on your host (e.g. Vercel).
# Convex project env is only for Convex functions; it does not supply secrets to SvelteKit +server routes
# unless you add a Convex action and call B2 from there instead of from this app server.
# B2_BUCKET=your-bucket-name   # required — exact name in Backblaze; must live in the same region as B2_REGION
# B2_REGION=eu-central-003
# B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com   # optional; default is https://s3.${B2_REGION}.backblazeb2.com
# Direct browser PUT to B2 requires bucket CORS rules in Backblaze; otherwise use POST /upload/direct (same-origin proxy).
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=
